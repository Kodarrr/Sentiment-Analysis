FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-common.txt backend/requirements-worker.txt backend/
RUN pip install --no-cache-dir --default-timeout=1000 -r backend/requirements-worker.txt

COPY backend/ backend/

ENV PYTHONPATH=/app
ENV HF_HOME=/app/.cache/huggingface

CMD ["python", "-m", "backend.worker.worker_main"]
