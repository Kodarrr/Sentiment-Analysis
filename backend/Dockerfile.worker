FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements-common.txt backend/requirements-worker.txt backend/
RUN pip install --no-cache-dir -r backend/requirements-worker.txt

COPY backend/ backend/

ENV PYTHONPATH=/app
ENV HF_HOME=/app/.cache/huggingface

CMD ["python", "-m", "backend.worker.worker_main"]
