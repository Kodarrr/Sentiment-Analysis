# Postgres
POSTGRES_USER=feedback
POSTGRES_PASSWORD=feedback
POSTGRES_DB=feedback
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://feedback:feedback@postgres:5432/feedback

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=30
# Must match the origin the dashboard is actually served from - i.e. the port
# in FRONTEND_PORT below. If you change FRONTEND_PORT, update this too, or
# every browser request from the dashboard will be blocked by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ML worker
SENTIMENT_NEGATIVE_THRESHOLD=0.85
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
BANGLA_MODEL_ID=sm-khalil/banglabert-sentigold
# Required if your Hugging Face repo is private (never commit real tokens):
HF_TOKEN=
HF_HOME=/app/.cache/huggingface
# Routing: auto (detects Bangla script), bangla (force Bangla model), or distilbert (force English model)
SENTIMENT_ENGINE=auto
CONFIDENCE_THRESHOLD=0.65
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=10

# Slack alerts (leave empty to no-op locally)
SLACK_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Host port the dashboard is published on. Change this if something else on
# your machine is already using 3000 - and update CORS_ALLOWED_ORIGINS above
# to match, or the dashboard's own requests to the API will be blocked.
FRONTEND_PORT=3000
